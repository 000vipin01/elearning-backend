# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearning
DB_USERNAME=elearning
DB_PASSWORD=elearning123

# JWT Configuration
JWT_SECRET=change-this-to-a-long-random-string-in-production

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Server Port
PORT=8080

# Admin Seed (creates admin user on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Payment Provider (mock or razorpay)
PAYMENT_PROVIDER=mock

# Razorpay (only needed if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Media Storage
MEDIA_DIR=./media

# Stream Token TTL (seconds)
STREAM_TOKEN_TTL=300

# Optional: SMTP (for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
